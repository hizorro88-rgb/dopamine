# DOPAMINE 설정 파일
# ─────────────────────────────────────────────
# 이 파일을 ".env" 로 복사한 뒤 값을 채우세요.
#   (Windows) copy .env.example .env
# .env 는 git 에 올라가지 않으므로, 비밀키를 넣어도 자동 배포(git pull)와 충돌하지 않습니다.

# 서버 포트
PORT=3000

# 후원 링크 (끄려면 off)
DONATION_URL=https://qr.kakaopay.com/Ej8euQo2R
# DONATION_LABEL=💛 서버비 후원하기 (카카오페이)

# 관리자 키 — 후원자 등록 + 홈의 🔧 관리자(맵 관리)에 사용. 반드시 나만 아는 값으로!
ADMIN_KEY=

# 허용 접속 도메인 (교차 사이트 남용 차단). 쉼표로 여러 개, 비우면 전체 허용
ALLOWED_ORIGINS=https://dopamine.me.kr,http://localhost:3000

# 낙하 배속(공의 속도). 비우면 기본 5
TIME_SCALE=

# 한 사람(IP)이 하루에 만들 수 있는 맵 수. 비우면 10, 0=무제한
MAP_DAILY_LIMIT=

# 아이템 소개 시간(ms). 비우면 6000, 0=건너뜀
ITEM_INTRO_MS=

# 자동 배포 폴링 간격(ms). 비우면 30000 (30초)
DEPLOY_POLL_MS=
